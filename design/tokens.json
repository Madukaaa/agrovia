{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"name": "Agrovia Design Tokens",
	"version": "1.0.0",
	"description": "Canonical design tokens for Agrovia theme, Elementor website kits, widgets, and block editor styles.",
	"brand": {
		"name": "Agrovia",
		"tagline": "Growing food. Restoring nature.",
		"domain": "Sustainable Agriculture & Regenerative Farming"
	},
	"colors": {
		"primary": {
			"value": "#18392b",
			"name": "Deep Forest Green",
			"description": "Primary brand color used for dominant headers, strong contrasts, and key action buttons."
		},
		"secondary": {
			"value": "#2c4a36",
			"name": "Dark Moss",
			"description": "Secondary brand accent used for supporting elements, hover states, and badges."
		},
		"accent": {
			"value": "#9daf95",
			"name": "Muted Sage",
			"description": "Organic highlight color for subtle badges, borders, and botanical touches."
		},
		"cream": {
			"value": "#f3eedf",
			"name": "Warm Cream",
			"description": "Warm natural tone for highlights, badges, and contrast surfaces."
		},
		"earth": {
			"value": "#7a6048",
			"name": "Earth Brown",
			"description": "Natural soil tone for category labels, metrics labels, and step counters."
		},
		"sand": {
			"value": "#d8cbb7",
			"name": "Soft Sand",
			"description": "Secondary warm neutral for image frames and subtle divider lines."
		},
		"background": {
			"value": "#f8f7f2",
			"name": "Off White Background",
			"description": "Default page background providing an organic, non-glaring reading surface."
		},
		"surface": {
			"value": "#ffffff",
			"name": "Surface White",
			"description": "Card, modal, and high-clarity content container background."
		},
		"text": {
			"value": "#242724",
			"name": "Charcoal Text",
			"description": "Primary high-contrast body typography color meeting WCAG AAA standard."
		},
		"text_muted": {
			"value": "#575e57",
			"name": "Muted Secondary Text",
			"description": "Secondary body typography color for subtitles, dates, and meta info."
		},
		"border": {
			"value": "#e2dfd2",
			"name": "Organic Warm Border",
			"description": "Delicate separator lines between content sections, tables, and cards."
		},
		"status": {
			"success": {
				"value": "#2d6a4f",
				"name": "Success Green"
			},
			"warning": {
				"value": "#b7791f",
				"name": "Warning Amber"
			},
			"error": {
				"value": "#9b2226",
				"name": "Error Crimson"
			},
			"info": {
				"value": "#2a6f97",
				"name": "Info Blue"
			}
		}
	},
	"typography": {
		"font_family": {
			"heading": "Cormorant Garamond, Georgia, serif",
			"body": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
			"mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace"
		},
		"scale": {
			"display_xl": {
				"font_size": "clamp(3rem, 6vw, 5.25rem)",
				"line_height": "1.05",
				"font_weight": "600",
				"letter_spacing": "-0.02em"
			},
			"display_l": {
				"font_size": "clamp(2.5rem, 5vw, 4rem)",
				"line_height": "1.10",
				"font_weight": "600",
				"letter_spacing": "-0.015em"
			},
			"h1": {
				"font_size": "clamp(2.25rem, 4vw, 3.25rem)",
				"line_height": "1.15",
				"font_weight": "600",
				"letter_spacing": "-0.01em"
			},
			"h2": {
				"font_size": "clamp(1.75rem, 3vw, 2.5rem)",
				"line_height": "1.20",
				"font_weight": "600",
				"letter_spacing": "-0.01em"
			},
			"h3": {
				"font_size": "clamp(1.375rem, 2.2vw, 1.875rem)",
				"line_height": "1.25",
				"font_weight": "600",
				"letter_spacing": "0"
			},
			"h4": {
				"font_size": "clamp(1.125rem, 1.6vw, 1.375rem)",
				"line_height": "1.35",
				"font_weight": "600",
				"letter_spacing": "0"
			},
			"body_l": {
				"font_size": "1.125rem",
				"line_height": "1.60",
				"font_weight": "400",
				"letter_spacing": "0"
			},
			"body": {
				"font_size": "1rem",
				"line_height": "1.65",
				"font_weight": "400",
				"letter_spacing": "0"
			},
			"body_s": {
				"font_size": "0.875rem",
				"line_height": "1.50",
				"font_weight": "400",
				"letter_spacing": "0"
			},
			"caption": {
				"font_size": "0.75rem",
				"line_height": "1.40",
				"font_weight": "600",
				"letter_spacing": "0.1em",
				"text_transform": "uppercase"
			}
		}
	},
	"layout": {
		"container": "1280px",
		"wide_container": "1440px",
		"padding": "clamp(1rem, 4vw, 2.5rem)",
		"breakpoints": {
			"mobile": "767px",
			"tablet": "1024px",
			"desktop": "1280px",
			"wide": "1440px"
		}
	},
	"spacing": {
		"xs": "0.25rem",
		"sm": "0.5rem",
		"md": "1rem",
		"lg": "1.5rem",
		"xl": "2rem",
		"2xl": "3rem",
		"3xl": "4.5rem",
		"4xl": "6rem"
	},
	"radii": {
		"none": "0",
		"sm": "4px",
		"md": "8px",
		"lg": "16px",
		"pill": "9999px"
	},
	"shadows": {
		"sm": "0 1px 3px rgba(36, 39, 36, 0.05)",
		"md": "0 4px 14px rgba(36, 39, 36, 0.08)",
		"lg": "0 12px 28px rgba(36, 39, 36, 0.12)"
	},
	"transitions": {
		"fast": "150ms cubic-bezier(0.4, 0, 0.2, 1)",
		"base": "250ms cubic-bezier(0.4, 0, 0.2, 1)",
		"smooth": "400ms cubic-bezier(0.16, 1, 0.3, 1)"
	},
	"elementor_mapping": {
		"global_colors": {
			"primary": "var(--agrovia-color-primary)",
			"secondary": "var(--agrovia-color-secondary)",
			"text": "var(--agrovia-color-text)",
			"accent": "var(--agrovia-color-accent)"
		},
		"global_typography": {
			"primary": "var(--agrovia-font-heading)",
			"secondary": "var(--agrovia-font-heading)",
			"text": "var(--agrovia-font-body)",
			"accent": "var(--agrovia-font-body)"
		}
	}
}
