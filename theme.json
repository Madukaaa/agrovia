{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Agrovia",
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "1280px",
			"wideSize": "1440px"
		},
		"color": {
			"custom": true,
			"customDuotone": false,
			"customGradient": true,
			"defaultGradients": false,
			"defaultPalette": false,
			"link": true,
			"palette": [
				{
					"name": "Deep Forest Green (Primary)",
					"slug": "primary",
					"color": "#18392b"
				},
				{
					"name": "Dark Moss (Secondary)",
					"slug": "secondary",
					"color": "#2c4a36"
				},
				{
					"name": "Muted Sage (Accent)",
					"slug": "accent",
					"color": "#9daf95"
				},
				{
					"name": "Warm Cream",
					"slug": "cream",
					"color": "#f3eedf"
				},
				{
					"name": "Earth Brown",
					"slug": "earth",
					"color": "#7a6048"
				},
				{
					"name": "Soft Sand",
					"slug": "sand",
					"color": "#d8cbb7"
				},
				{
					"name": "Off White (Background)",
					"slug": "background",
					"color": "#f8f7f2"
				},
				{
					"name": "Surface White",
					"slug": "surface",
					"color": "#ffffff"
				},
				{
					"name": "Charcoal (Text)",
					"slug": "text",
					"color": "#242724"
				},
				{
					"name": "Muted Text",
					"slug": "text-muted",
					"color": "#575e57"
				},
				{
					"name": "Warm Border",
					"slug": "border",
					"color": "#e2dfd2"
				},
				{
					"name": "Success",
					"slug": "success",
					"color": "#2d6a4f"
				},
				{
					"name": "Warning",
					"slug": "warning",
					"color": "#b7791f"
				},
				{
					"name": "Error",
					"slug": "error",
					"color": "#9b2226"
				},
				{
					"name": "Info",
					"slug": "info",
					"color": "#2a6f97"
				}
			]
		},
		"typography": {
			"fluid": true,
			"customFontSize": true,
			"dropCap": true,
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": true,
			"lineHeight": true,
			"textColumns": true,
			"textDecoration": true,
			"textTransform": true,
			"fontFamilies": [
				{
					"name": "Cormorant Garamond (Heading)",
					"slug": "heading",
					"fontFamily": "'Cormorant Garamond', Georgia, serif"
				},
				{
					"name": "Inter (Body)",
					"slug": "body",
					"fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif"
				},
				{
					"name": "Monospace",
					"slug": "mono",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace"
				}
			],
			"fontSizes": [
				{
					"name": "Caption",
					"slug": "caption",
					"size": "0.75rem"
				},
				{
					"name": "Small",
					"slug": "small",
					"size": "0.875rem"
				},
				{
					"name": "Medium",
					"slug": "medium",
					"size": "1rem"
				},
				{
					"name": "Large",
					"slug": "large",
					"size": "1.25rem",
					"fluid": {
						"min": "1.125rem",
						"max": "1.35rem"
					}
				},
				{
					"name": "Extra Large",
					"slug": "x-large",
					"size": "1.75rem",
					"fluid": {
						"min": "1.5rem",
						"max": "2rem"
					}
				},
				{
					"name": "2X Large",
					"slug": "2x-large",
					"size": "2.25rem",
					"fluid": {
						"min": "1.75rem",
						"max": "2.75rem"
					}
				},
				{
					"name": "3X Large",
					"slug": "3x-large",
					"size": "3rem",
					"fluid": {
						"min": "2.25rem",
						"max": "3.5rem"
					}
				},
				{
					"name": "4X Large",
					"slug": "4x-large",
					"size": "3.75rem",
					"fluid": {
						"min": "2.75rem",
						"max": "4.5rem"
					}
				}
			]
		},
		"spacing": {
			"customSpacingSize": true,
			"blockGap": true,
			"margin": true,
			"padding": true,
			"units": ["px", "em", "rem", "vh", "vw", "%"],
			"spacingScale": {
				"operator": "*",
				"increment": 1.5,
				"steps": 7,
				"mediumStep": 1.5,
				"unit": "rem"
			},
			"spacingSizes": [
				{
					"name": "Extra Small",
					"slug": "xs",
					"size": "0.25rem"
				},
				{
					"name": "Small",
					"slug": "sm",
					"size": "0.5rem"
				},
				{
					"name": "Medium",
					"slug": "md",
					"size": "1rem"
				},
				{
					"name": "Large",
					"slug": "lg",
					"size": "1.5rem"
				},
				{
					"name": "Extra Large",
					"slug": "xl",
					"size": "2rem"
				},
				{
					"name": "2X Large",
					"slug": "2xl",
					"size": "3rem"
				},
				{
					"name": "3X Large",
					"slug": "3xl",
					"size": "4.5rem"
				},
				{
					"name": "4X Large",
					"slug": "4xl",
					"size": "6rem"
				}
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"name": "Subtle",
					"slug": "sm",
					"shadow": "0 1px 3px rgba(36, 39, 36, 0.05)"
				},
				{
					"name": "Card Elevation",
					"slug": "md",
					"shadow": "0 4px 14px rgba(36, 39, 36, 0.08)"
				},
				{
					"name": "Modal / Drawer",
					"slug": "lg",
					"shadow": "0 12px 28px rgba(36, 39, 36, 0.12)"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--text)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--lg)"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--secondary)"
					}
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "600",
					"lineHeight": "1.15",
					"letterSpacing": "-0.01em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--4x-large)",
					"fontWeight": "700",
					"lineHeight": "1.08"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--2x-large)",
					"fontWeight": "600",
					"lineHeight": "1.15"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontWeight": "600",
					"lineHeight": "1.25"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "600",
					"lineHeight": "1.35"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "600"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "700",
					"textTransform": "uppercase",
					"letterSpacing": "0.08em"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "#ffffff"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "0.9375rem",
					"fontWeight": "600"
				},
				"border": {
					"radius": "8px"
				},
				"spacing": {
					"padding": {
						"top": "0.875rem",
						"bottom": "0.875rem",
						"left": "1.75rem",
						"right": "1.75rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--secondary)",
						"text": "#ffffff"
					}
				}
			}
		},
		"blocks": {
			"core/quote": {
				"border": {
					"left": {
						"color": "var(--wp--preset--color--secondary)",
						"width": "3px",
						"style": "solid"
					}
				},
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "1.35rem",
					"fontStyle": "italic",
					"lineHeight": "1.4"
				},
				"spacing": {
					"padding": {
						"left": "1.5rem"
					},
					"margin": {
						"top": "2rem",
						"bottom": "2rem"
					}
				}
			},
			"core/pullquote": {
				"border": {
					"color": "var(--wp--preset--color--secondary)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "1.75rem",
					"fontStyle": "italic"
				},
				"color": {
					"text": "var(--wp--preset--color--primary)"
				}
			},
			"core/table": {
				"color": {
					"text": "var(--wp--preset--color--text)"
				}
			},
			"core/code": {
				"color": {
					"background": "var(--wp--preset--color--surface)",
					"text": "var(--wp--preset--color--text)"
				},
				"border": {
					"color": "var(--wp--preset--color--border)",
					"radius": "8px",
					"style": "solid",
					"width": "1px"
				},
				"spacing": {
					"padding": {
						"top": "1.25rem",
						"bottom": "1.25rem",
						"left": "1.25rem",
						"right": "1.25rem"
					}
				}
			}
		}
	}
}
